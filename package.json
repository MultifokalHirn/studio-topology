{
  "name": "studio-planner",
  "version": "0.1.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "schema:gen": "tsx scripts/schema-gen.ts",
    "schema:check": "tsx scripts/schema-gen.ts --check",
    "seed:validate": "tsx scripts/seed-validate.ts",
    "seed:build": "tsx scripts/seed-build.ts",
    "seed:check": "tsx scripts/seed-build.ts --check"
  },
  "author": "",
  "license": "UNLICENSED",
  "description": "Local-first, to-scale, connector-accurate planner for a music studio",
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tabler/icons-react": "^3.48.0",
    "@tanstack/react-table": "^9.2.5",
    "clsx": "^2.1.1",
    "elkjs": "^0.12.0",
    "idb-keyval": "^6.3.0",
    "immer": "^11.1.21",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "ulid": "^3.0.2",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fake-indexeddb": "^6.2.5",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "private": true,
  "type": "module"
}
